# ==============================================================================
# Gemini Enterprise - Edu Portal: environment template
# ------------------------------------------------------------------------------
#   cp .env.example .env          # one environment
#   cp .env.example .env.dev      # or one file per environment (.env.dev, .env.prod, ...)
#
# Fill in the values, then:
#   npm start                                  # local run (reads .env)
#   ./scripts/deploy.sh --env-file .env.dev    # Terraform + Cloud Run deploy
#
# Every .env* file except this template is gitignored. Never commit real values.
# Generate strong secrets with:  openssl rand -hex 32
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Google Cloud deployment target  (required for ./scripts/deploy.sh)
# ------------------------------------------------------------------------------
# Project ID (not the number). Also used locally for Gemini / infographic calls;
# if empty locally, the app falls back to `gcloud config get-value project`.
GCP_PROJECT_ID=your-gcp-project-id

# Region for Cloud Run, Cloud SQL and the bucket, e.g. us-central1, europe-west1, asia-east1
GCP_REGION=us-central1

# Cloud Run service name. Use a different one per environment, e.g. edu-portal-dev / edu-portal.
CLOUD_RUN_SERVICE=edu-portal

# Cloud SQL for PostgreSQL instance and database (environments may share an
# instance as long as each one uses its own CLOUD_SQL_DATABASE).
CLOUD_SQL_INSTANCE=edu-portal-sql
CLOUD_SQL_DATABASE=edu_portal
CLOUD_SQL_TIER=db-f1-micro
CLOUD_SQL_DELETION_PROTECTION=true

# Public bucket for generated infographics. Must be globally unique,
# e.g. <your-project-id>-edu-portal-infographics
INFOGRAPHIC_BUCKET=your-gcp-project-id-edu-portal-infographics

# Optional custom domain, e.g. portal.example.edu (blank = use the run.app URL)
CUSTOM_DOMAIN=

# Optional Cloud Run tuning
ALLOW_UNAUTHENTICATED=true
CLOUD_RUN_MAX_INSTANCES=10

# Optional: keep Terraform state in a GCS bucket you own (recommended for teams).
# Blank = local state under terraform/terraform.tfstate.d/<workspace>/ (gitignored).
TF_STATE_BUCKET=


# ------------------------------------------------------------------------------
# 2. Secrets  (stored in Secret Manager by Terraform; never committed)
# ------------------------------------------------------------------------------
# Built-in break-glass admin accounts. Usernames: edu_portal_s_admin (super),
# edu_portal_admin (assistant), demo-admin (assistant).
# SUPER_ADMIN_PASSWORD is required for deploys (min 12 chars). Leaving the other
# two blank disables those accounts. Locally, a blank SUPER_ADMIN_PASSWORD makes
# the server print a one-off random password at startup.
SUPER_ADMIN_PASSWORD=
ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Signs session cookies. Blank on deploy = Terraform generates one.
# Locally, blank = random per run (you get signed out on restart).
SESSION_SECRET=

# Encrypts the SMTP password stored in the database. Blank on deploy = generated.
# Changing it later means re-entering the SMTP password in Admin > Settings > Email.
SETTINGS_ENCRYPTION_KEY=

# Cloud SQL `postgres` user password. Blank = Terraform generates one.
DB_PASSWORD=


# ------------------------------------------------------------------------------
# 3. Optional demo user  (created on first boot when both values are set)
# ------------------------------------------------------------------------------
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Gemini Enterprise app URL the demo user's "Try it" buttons open
DEMO_USER_GE_APP_LINK=


# ------------------------------------------------------------------------------
# 4. App runtime  (local development; Terraform sets the Cloud Run equivalents)
# ------------------------------------------------------------------------------
PORT=8080

# Blank = local SQLite file (SQLITE_PATH, default ./edu_portal.db).
# Postgres example: postgres://USER:PASSWORD@localhost:5432/edu_portal
DATABASE_URL=
SQLITE_PATH=

# Vertex AI model for "Draft with Gemini"
GEMINI_MODEL=gemini-3.8-flash

# Infographic generation (Vertex AI image model + INFOGRAPHIC_BUCKET above)
INFOGRAPHIC_MODEL=gemini-nano-banana-2.1
INFOGRAPHIC_LOCATION=global
# true only if INFOGRAPHIC_BUCKET already holds the pre-generated seed images;
# otherwise generate them: Admin > Generate missing, or `npm run infographics`.
INFOGRAPHIC_SEED_IMAGES=false

# Base URL for links in emails (invites / password resets). Blank = request host.
PUBLIC_BASE_URL=

# Local gcloud user credentials bill API calls to this project (blank = GCP_PROJECT_ID)
GCP_QUOTA_PROJECT=


# ------------------------------------------------------------------------------
# 5. Email fallback  (optional; Admin > Settings > Email takes precedence)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Edu Portal"
SMTP_FROM_EMAIL=
